# OpenAI API configuration
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Any OpenAI model, e.g. gpt-4o-mini, gpt-4o, gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini

# Optional: override where reports / audit log / policy data are stored
# GOVERNAI_DATA_DIR=./data

# --- Firebase (optional) ----------------------------------------------------
# Leave all of this empty to run GovernAI with local file storage and no
# authentication (the default for local demos and the test suite).
#
# Firebase console -> Project settings -> General: the project id.
FIREBASE_PROJECT_ID=

# Firebase console -> Project settings -> Service accounts ->
# "Generate new private key". Point this at the downloaded JSON file...
FIREBASE_CREDENTIALS_FILE=./serviceAccountKey.json
# ...or paste the whole JSON inline instead (useful for hosted deployments):
# FIREBASE_CREDENTIALS_JSON=

# Store governance reports + the audit log in Firestore (on by default once
# Firebase credentials are set). Set to false to keep using local files.
# GOVERNAI_USE_FIRESTORE=true
# FIRESTORE_REPORTS_COLLECTION=governance_reports
# FIRESTORE_AUDIT_COLLECTION=audit_log

# Reject any API request without a valid Firebase ID token. Turn this on once
# the frontend is signing users in.
# GOVERNAI_REQUIRE_AUTH=true

# Extra browser origins allowed to call the API (comma-separated), e.g. a
# deployed frontend domain.
# GOVERNAI_CORS_ORIGINS=https://governai.example.com
