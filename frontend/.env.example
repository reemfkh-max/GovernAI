# ---------------------------------------------------------------------------
# Firebase Authentication (GovernAI frontend)
#
# 1. Copy this file to `frontend/.env`
# 2. Firebase console -> Project settings -> General -> "Your apps" -> Web app
#    Copy each value from the generated `firebaseConfig` object below.
# 3. Firebase console -> Build -> Authentication -> Sign-in method
#    Enable the "Email/Password" provider.
# 4. Restart `npm run dev` (Vite only reads env files at startup).
#
# Only variables prefixed with VITE_ are exposed to the browser. These Firebase
# web keys are public identifiers, not secrets — access is controlled by your
# Firebase security rules and authorised domains. Still, `.env` is gitignored:
# never commit real values.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
