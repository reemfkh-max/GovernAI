rules_version = '2';

// GovernAI never reads or writes Firestore from the browser: the React app
// talks to the FastAPI backend, which uses the Firebase Admin SDK (Admin
// access bypasses these rules). So the safe posture for client SDKs is to
// deny everything — governance reports and the audit trail must only be
// written by the server-side agent pipeline.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
